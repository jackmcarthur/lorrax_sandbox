&control
   prefix = 'MoS2'
   calculation = 'nscf'
   pseudo_dir = './'
   outdir = './mini_out'
   verbosity = 'high'
/
&system
   ecutwfc = 30.0
   ecutrho = 120.0
   nbnd = 40
ibrav = 0
   nat = 3
   ntyp = 2
   noncolin = .true.
   lspinorb = .true.
   no_t_rev = .true.
   assume_isolated = '2D'
/
&electrons
   electron_maxstep = 100
   conv_thr = 1e-10
   diagonalization = 'david'
   diago_full_acc = .true.
/
ATOMIC_SPECIES
   Mo 95.94 Mo.upf
   S  32.07 S.upf

CELL_PARAMETERS angstrom
   3.164292  0.000000  0.00000
  -1.582142  2.740357  0.00000
   0.000000  0.000000 12.00000

ATOMIC_POSITIONS crystal
   Mo  0.666667  0.333333  0.000000
   S   0.333333  0.666667  0.131928
   S   0.333333  0.666667 -0.131928

K_POINTS automatic
 2 2 1 0 0 0
