&input_pw2bgw
   prefix = 'MoS2'
   outdir = './mini_out'
   real_or_complex = 2
   wfng_flag = .true.
   wfng_file = 'WFN_mini'
   wfng_kgrid = .true.
   wfng_nk1 = 2
   wfng_nk2 = 2
   wfng_nk3 = 1
   wfng_dk1 = 0.0
   wfng_dk2 = 0.0
   wfng_dk3 = 0.0
   vxc_flag = .true.
   vxc_file = 'vxc_mini.dat'
   vxc_diag_nmin = 1
   vxc_diag_nmax = 40
   kih_flag = .true.
   kih_file = 'kih_mini.dat'
   rhog_flag = .false.
/
