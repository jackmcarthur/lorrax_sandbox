# =============================================================================
# Whitelist-based .gitignore for lorrax_sandbox
#
# Strategy: ignore everything, then selectively un-ignore the file types and
# directories we want tracked. This prevents accidentally committing large
# HDF5 files, binary wavefunctions, compiled objects, or GPU libraries.
# =============================================================================

# Ignore everything by default
*

# --- Un-ignore directory structure (recursively) ---
!*/

# --- Un-ignore documentation and config ---
!*.md
!*.yaml
!*.yml
!*.toml
!*.txt
!*.json

# --- Un-ignore source code and scripts ---
!*.py
!*.sh
!*.lua

# --- Un-ignore input files ---
!*.in
!*.inp

# --- Un-ignore small data files ---
!*.dat
!*.csv
!*.spec

# --- Un-ignore pseudopotentials ---
!*.upf
!*.UPF

# --- Un-ignore plots (keep PNGs for reports) ---
!*.png

# --- Un-ignore patches (lesson of rescue_2026-07-22: blocked patches were lost) ---
!*.patch

# --- Un-ignore git housekeeping ---
!.gitignore
!.gitkeep

# =============================================================================
# Re-ignore things that match above patterns but should NOT be tracked
# =============================================================================

# Virtual environment (contains .py, .so, etc.)
.venv/

# Python caches
__pycache__/
*.pyc
*.pyo

# uv lock file (large, auto-generated)
uv.lock

# Jupyter
.ipynb_checkpoints/

# XLA dump dirs (per-jit memory-usage-report.txt + .hlo + .pb files;
# routinely thousands of small files per profiled run, tens to
# hundreds of MB).  Quote the relevant HLO content in the report
# instead of checking in the dumps.
xla_dump/
xla_dump_*/

# Profiling sidecar artifacts from scripts/profiling/run_profiled.py
memprof/
xprof/

# Per-run tmp/ caches (zeta_q.h5 staging, slab IO temp files etc.;
# *.h5 already blocked but the dir itself bloats listings).
tmp/

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# =============================================================================
# Explicitly blocked large/binary types (defense in depth)
# =============================================================================
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.pkl
*.pickle
*.so
*.o
*.a
*.dylib

# BGW binary formats (no extension)
# These are caught by the whitelist approach, but for clarity:
# WFN, WFNq, EpsDyn, EpsInvDyn are all binary and extensionless,
# so they're already ignored by the default * rule.

# Per-(k,n,omega) Sigma debug dumps -- large and regenerable
# (sigma_freq_debug_output = true); conclusions come from eqp*.dat /
# sigma_diag.dat, which stay tracked.
runs/**/sigma_freq_debug.dat

# =============================================================================
# fastloop mini-deck + pinned references (2026-07-31, CLAIMS row 17):
# DELIBERATE exception to the h5/npz/binary blocks above — the checked-in
# miniature system is the fastloop's deliverable (~15 MB total, fixed size).
# Last-match-wins puts these AFTER the blanket blocks on purpose.
# =============================================================================
!fastloop/*.sbatch
!fastloop/deck_mini/WFN_mini.h5
!fastloop/deck_mini/RHO_mini
!fastloop/deck_mini/mini_out/MoS2.save/data-file-schema.xml
!fastloop/reference/*.sig.npz

# =============================================================================
# Curated run evidence (2026-08-04): per-rank stdout/stderr under runs/.
# The whitelist above tracks source and .md/.txt/.dat but not .out/.err/.log,
# which silently dropped the primary evidence of every gate — a stranded
# collective is visible ONLY in the per-rank files. Scoped to runs/ so live
# work trees stay untracked. Last-match-wins puts these after the blocks.
# =============================================================================
!runs/**/*.out
!runs/**/*.err
!runs/**/*.log
