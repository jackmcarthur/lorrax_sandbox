# bse_k_grid validation input: modest htransform window (nband=40 <=48) so the
# fine-grid conduction ENERGY recovery stays ~1 meV (10_lorrax_exciton_bands
# nband<=48 finding), isolating the true k-densification error.
[cohsex]
bse_k_grid = 12 12 1
restart = false
centroids_file = centroids_frac_640.txt
nval = 26
ncond = 14
nband = 40
sys_dim = 2
x_only = false
do_screened = true
bispinor = false
screening_method = minimax
fermi_reference = midgap
sigma_at_dft_energies = true
memory_per_device_gb = 28
wfn_file = WFN.h5
bare_coulomb_cutoff = 30.0
