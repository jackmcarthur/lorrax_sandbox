# LORRAX deck descriptor for MoS2 4x4x1 / ecutwfc=30 Ry / 600-band / SYMMETRY ON
# Used by gw.kin_ion_io, psp.get_dipole_mtxels, gw.gw_jax and
# bandstructure.htransform.
#
# BAND WINDOW SPLIT (same contract as the b300 family, scaled to 600):
#   nband = 600  -> chi/W (polarizability) band sum: 600 bands.
#                   Meta.b_id_4 = round_up(600, world_size) = 640 at P=64;
#                   psi(G) for bands [600, 640) is zeroed in
#                   load_centroids_band_chunked, so exactly 600 bands
#                   contribute even though the source WFN holds 1024.
#   nval  = 26   -> ALL valence bands (nelec = 26 spinor bands for this deck).
#   ncond = 18   -> sigma DIAGONAL conduction window (UNCHANGED from b300).
#      => Meta.b_id_1 = 0, b_id_3 = 44.  Sigma diagonals on bands [0, 44).
#
# SOURCE WFN: WFN_b1024.h5 (1024 bands, 10 IBZ k, nspinor=2), same deck /
# ecut / k-grid as WFN_b300.h5 (0.624 MB per band in all three files).
# No new NSCF was needed for 600 bands.
[cohsex]
restart = false
centroids_file = centroids_b600.txt
nval = 26
ncond = 18
nband = 600
sys_dim = 2
do_screened = true
bispinor = false
qp_solver = one_shot_dft
use_ppm_sigma = true
screening_method = minimax
ppm_omega_p = 2.0
ppm_fallback_omega = 2.0
sigma_omega_min_ev = -10.0
sigma_omega_max_ev = 10.0
sigma_omega_step_ev = 0.5
sigma_regularization_ev = 0.25
fermi_reference = midgap
memory_per_device_gb = 40.0
use_ffi_io = true
slab_io = auto
charge_zeta_solve = rank_truncate
distributed_cholesky = auto
distributed_lu = auto
hartree_source = auto
wfn_file = WFN.h5
sigma_diag_file = sigma_diag.dat
sigma_omega_h5_file = sigma_mnk.h5

K_POINTS {crystal_b}
4
  0.0000 0.0000 0.0000 40   # gamma
  0.0000 0.5000 0.0000 40   # M
  0.3333 0.3333 0.0000 40   # K
  0.0000 0.0000 0.0000 40   # gamma
