# LORRAX deck descriptor for MoS2 4x4x1 / ecutwfc=30 Ry / 300-band / SYMMETRY ON
# Used by gw.kin_ion_io, psp.get_dipole_mtxels and bandstructure.htransform.
#
# BAND WINDOW SPLIT (this is the whole point of the b300 family):
#   nband = 300  -> chi/W (polarizability) band sum: ALL 300 NSCF bands.
#                   Meta.b_id_4 = round_up(300, world_size).
#   nval  = 26   -> ALL valence bands (nelec = 26 spinor bands for this deck).
#   ncond = 18   -> sigma DIAGONAL conduction window.
#   => Meta.b_id_1 = nelec-nval = 0, b_id_3 = nelec+ncond = 44.
#      Sigma diagonals are computed for bands [0, 44) = 26 val + 18 cond.
[cohsex]
restart = false
centroids_file = centroids_b300.txt
nval = 26
ncond = 18
nband = 300
sys_dim = 2
do_screened = true
bispinor = false
qp_solver = one_shot_dft
use_ppm_sigma = true
screening_method = minimax
ppm_omega_p = 2.0
ppm_fallback_omega = 2.0
sigma_omega_min_ev = -10.0
sigma_omega_max_ev = 10.0
sigma_omega_step_ev = 0.5
sigma_regularization_ev = 0.25
fermi_reference = midgap
memory_per_device_gb = 40.0
use_ffi_io = true
slab_io = auto
charge_zeta_solve = rank_truncate
distributed_cholesky = auto
distributed_lu = auto
hartree_source = auto
wfn_file = WFN_b300.h5
sigma_diag_file = sigma_diag.dat
sigma_omega_h5_file = sigma_mnk.h5

K_POINTS {crystal_b}
4
  0.0000 0.0000 0.0000 40   # gamma
  0.0000 0.5000 0.0000 40   # M
  0.3333 0.3333 0.0000 40   # K
  0.0000 0.0000 0.0000 40   # gamma
