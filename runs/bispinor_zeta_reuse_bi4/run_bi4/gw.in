# BISPINOR zeta-reuse gate -- archived AX bi4 shape, restart=false
[cohsex]
restart = false
centroids_file = centroids_C.txt
centroids_file_current = centroids_T.txt
nval = 26
ncond = 102
nband = 128
sys_dim = 2
x_only = false
do_screened = true
bispinor = true
qp_solver = one_shot_dft
use_ppm_sigma = true
screening_method = minimax
ppm_omega_p = 2.0
ppm_fallback_omega = 2.0
sigma_omega_min_ev = -10.0
sigma_omega_max_ev = 10.0
sigma_omega_step_ev = 0.5
sigma_regularization_ev = 0.25
fermi_reference = midgap
use_chunked_isdf = true
memory_per_device_gb = 40.0
slab_io = auto
charge_zeta_solve = rank_truncate
distributed_cholesky = auto
distributed_lu = auto
hartree_source = auto
wfn_file = WFN.h5
sigma_diag_file = sigma_diag.dat
sigma_omega_h5_file = sigma_mnk.h5

K_POINTS {crystal_b}
4
  0.0000 0.0000 0.0000 40
  0.0000 0.5000 0.0000 40
  0.3333 0.3333 0.0000 40
  0.0000 0.0000 0.0000 40
