        cols, _ = _select_compare_cols(T, nlog, 3, seed=0)
        chain = build_w_omega_chain(dq, matvec, gen, sh, cols, CHAIN_LEN)
    
        # static + imaginary-axis closure vs the per-q oracle (finite-q floor is ~10x
