# CLEAN-WINDOW variant (nval=4/ncond=8/nband=34, htransform window bands
# 22-34) at 1000 CENTROIDS — the follow-up test of the window-artifact
# mechanism (05_htransform_spbands): window (22,34) boundaries sit at
# 21|22 = 80.7 meV and 33|34 = 2194 meV between-pair gaps (gap_scan.py) —
# no Kramers pair is cut, unlike the production (24,32) window whose
# 31|32 = 5.9 meV top boundary rings 100-1000 meV off-grid and produces
# the iQ 6/9/16-17 exciton dips.  Capacity: 144*12 = 1728 <= ns*n_mu =
# 2000 (needs the 1000-centroid basis; impossible at 640).
# Driver conduction slots: b_min = nval_in = 4 -> caches bands 26-29
# (idx 4-7), with 30-33 as guards.  nband=34 (NOT nval+ncond): Meta
# b_id_4_user is the ABSOLUTE band-budget top (wfn_transforms.py:1870).
[cohsex]
restart = false
centroids_file = centroids_frac_1000.txt
nval = 4
ncond = 8
nband = 34
sys_dim = 2
x_only = false
do_screened = true
bispinor = false
self_consistent = false
use_ppm_sigma = false
screening_method = minimax
sigma_debug_split_contrib = true
fermi_reference = midgap
sigma_at_dft_extrapolate = false
sigma_at_dft_energies = true
use_chunked_isdf = true
memory_per_device_gb = 28
write_no_head_vw = false
debug_hartree = false
write_w_copies_debug = false
wfn_file = WFN.h5
output_file = eqp0.dat
sigma_omega_h5_file = sigma_mnk.h5
sigma_freq_debug_output = true
bare_coulomb_cutoff = 30.0

K_POINTS {crystal_b}
2
  0.0000 0.0000 0.0000 1   # Gamma
  0.0000 0.5000 0.0000 2   # M
