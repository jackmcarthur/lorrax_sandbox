# GWJAX input for MoS2 3x3 SOC — sym-vs-nosym PR3 validation
# Run B (nosym WFN, ntran=1): no symmetry unfold; IBZ cascade trivial
# Σ_X only (x_only=true) — bispinor=false (V_q transverse not under test)
[cohsex]

restart = false

centroids_file = centroids_frac_399.txt

nval = 26
ncond = 30
nband = 56
sys_dim = 2

x_only = true
do_screened = false
bispinor = false
self_consistent = false

# bare_coulomb_cutoff explicit — LORRAX default ≠ BGW (see KNOWN issues)
bare_coulomb_cutoff = 30.0

use_ppm_sigma = false
screening_method = minimax
sigma_debug_split_contrib = true
fermi_reference = midgap
sigma_at_dft_extrapolate = false
sigma_at_dft_energies = true

use_chunked_isdf = true
memory_per_device_gb = 0.0

write_no_head_vw = true
debug_hartree = true
write_w_copies_debug = true

wfn_file = WFN.h5
output_file = eqp0.dat
sigma_omega_h5_file = sigma_mnk.h5
sigma_freq_debug_output = true

K_POINTS {crystal_b}
4
  0.0000 0.0000 0.0000 80
  0.0000 0.5000 0.0000 80
  0.3333 0.3333 0.0000 80
  0.0000 0.0000 0.0000 80
