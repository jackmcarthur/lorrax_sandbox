# BSE exciton-bandstructure input for MoS2 — 12x12 via the bse_k_grid economy
# route (coarse 6x6 GW/W restart -> fine 12x12 BSE; W auto zero-padded, ψ/ε
# interpolated by the htransform, V_Q0 rebuilt at the fine mini-BZ head).
#
# htransform interp window [0,48) = 26 valence + 22 conduction guards.  Modest
# by design: 1600 centroids over 90 bands corrupts on-grid ε (465 meV recon,
# run-10 lesson); nband=48 gives ~0 meV on-grid.  BSE window (CLI --n-val 8
# --n-cond 8) = bands 18..34, strictly interior, guarded by bands 34..47.
[cohsex]
centroids_file = centroids_frac_1496.txt
nval = 26
ncond = 22
nband = 48
sys_dim = 2
bispinor = false
wfn_file = WFN.h5
bse_k_grid = 12 12 1

K_POINTS {crystal_b}
4
  0.000000 0.000000 0.000000 1    # Gamma
  0.000000 0.500000 0.000000 20   # M
  0.333333 0.333333 0.000000 12   # K
  0.000000 0.000000 0.000000 23   # Gamma
