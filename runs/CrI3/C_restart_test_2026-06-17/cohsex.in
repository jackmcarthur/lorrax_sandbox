[cohsex]
wfn_file = WFN.h5

# CrI3 monolayer, 6x6x1, nspinor=2 (bispinor). Bispinor transverse-restart
# round-trip test (agent/bispinor-ibz-lorentz-unfold).  Small Sigma window
# for a FAST gate; the restart machinery is band-count independent.
nval = 6
ncond = 4
nband = 80
sys_dim = 2

bispinor = true

centroids_file = centroids_frac_300.txt
centroids_file_current = centroids_frac_102_current.txt

memory_per_device_gb = 36.0

restart = false
max_r_chunks = -1

# cusolvermp LU off per restart-test spec (deterministic |λ|-pseudoinverse
# transverse-CCT solve path).
cusolvermp_lu = off

x_only = true
do_screened = false
screening = cohsex

vhead = 0.0
whead_0freq = 0.0
write_wfn_h5 = false
