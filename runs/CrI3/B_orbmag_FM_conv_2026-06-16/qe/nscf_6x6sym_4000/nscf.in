&control
   prefix = 'CrI3'
   pseudo_dir = './'
   calculation = 'nscf'
   verbosity = 'high'
   wf_collect = .true.
   disk_io = 'low'
/
&system
   ecutwfc = 30.0
   ibrav = 0
   nat = 8
   ntyp = 2
   noncolin = .true.
   lspinorb = .true.
   no_t_rev = .true.
   nbnd = 4000
   assume_isolated = '2D'
   starting_magnetization(1) = 0.5
   starting_magnetization(2) = 0.0
   angle1(1) = 0.0
   angle1(2) = 0.0
   angle2(1) = 0.0
   angle2(2) = 0.0
/
! SYMMETRY ON (no nosym): QE reduces the 6x6 grid to the magnetic IBZ and
! stores the magnetic point-group operations.  no_t_rev=.true. removes
! time-reversal (not a symmetry of the FM state).  This is the IBZ test/
! validation WFN for the symmetry-reduced orbital-magnetization mode.
&electrons
   electron_maxstep = 200
   conv_thr = 1e-9
   diagonalization = 'david'
   diago_david_ndim = 2
   diago_full_acc = .true.
/

ATOMIC_SPECIES
   Cr  51.996 'Cr.upf'
   I  126.904 'I.upf'

CELL_PARAMETERS angstrom
   6.867000   0.000000   0.000000
  -3.433500   5.946996   0.000000
   0.000000   0.000000  18.000000

ATOMIC_POSITIONS crystal
   Cr  0.333333333  0.666666667  0.000377778
   Cr  0.666666667  0.333333333  0.999622226
   I   0.349896669  0.998803318  0.913106084
   I   0.001196661  0.351093352  0.913106084
   I   0.648906648  0.650103331  0.913106084
   I   0.650103331  0.001196663  0.086893886
   I   0.998803318  0.648906648  0.086893886
   I   0.351093352  0.349896699  0.086893886

K_POINTS automatic
 6 6 1 0 0 0
