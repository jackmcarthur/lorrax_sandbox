# BGW sigma for CrI3 6x6 30 Ry bispinor test bed (static COHSEX) -- FULL 8 IBZ k
# Use this when allocation has >=35 min remaining; current 4-min/k means
# 8 k = 32 min.
band_index_min 65
band_index_max 78
number_bands 84
screened_coulomb_cutoff 30.0
bare_coulomb_cutoff 30.0

frequency_dependence 0
exact_static_ch 0

cell_slab_truncation

degeneracy_check_override
use_wfn_hdf5
dont_use_vxcdat
use_kihdat
fermi_level -4.95
fermi_level_absolute

begin kpoints
  0.000000000  0.000000000  0.000000000   1.0
  0.000000000  0.166666667  0.000000000   1.0
  0.000000000  0.333333333  0.000000000   1.0
  0.000000000  0.500000000  0.000000000   1.0
  0.166666667  0.166666667  0.000000000   1.0
  0.166666667  0.333333333  0.000000000   1.0
  0.166666667  0.500000000  0.000000000   1.0
  0.333333333  0.333333333  0.000000000   1.0
end
