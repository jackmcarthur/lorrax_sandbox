# BGW sigma for CrI3 6x6 30 Ry bispinor test bed (static COHSEX)
# bare_coulomb_cutoff explicit (LORRAX default = 4*ecutwfc; BGW default = ecutwfc;
# set equal to LORRAX-convention to enable comparison)
band_index_min 65
band_index_max 78
number_bands 84
screened_coulomb_cutoff 30.0
bare_coulomb_cutoff 30.0

frequency_dependence 0
exact_static_ch 0

cell_slab_truncation

degeneracy_check_override
use_wfn_hdf5
dont_use_vxcdat
use_kihdat
fermi_level -4.95
fermi_level_absolute

# NOTE: full 8-IBZ k-points trial timed out under interactive allocation
# (4 min/k × 8 k = 32 min). Reduced to 3 IBZ k-points (Γ, M-like, K-like)
# to fit budget. Re-enable the full 8 in sigma.inp.full and rerun for the
# permanent reference when allocation time permits.
begin kpoints
  0.000000000  0.000000000  0.000000000   1.0
  0.000000000  0.333333333  0.000000000   1.0
  0.333333333  0.333333333  0.000000000   1.0
end
