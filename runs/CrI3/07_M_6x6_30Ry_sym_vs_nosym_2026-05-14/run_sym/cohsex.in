# GWJAX input for CrI3 6x6 30Ry SOC — sym-vs-nosym PR3 validation
# Run A (sym WFN, ntran=6 incl. inversion): exercises PR3 ψ-side unfold
# Σ_X only (x_only=true) — bispinor=false (charge-only)
[cohsex]

restart = false

wfn_file = WFN.h5
centroids_file = centroids_frac_300.txt

nval = 70
ncond = 14
nband = 84
sys_dim = 2

x_only = true
do_screened = false
bispinor = false
self_consistent = false

# bare_coulomb_cutoff explicit — LORRAX default = 4*ecutwfc, BGW default = ecutwfc
bare_coulomb_cutoff = 30.0

screening = cohsex
vhead = 0.0
whead_0freq = 0.0

use_chunked_isdf = true
memory_per_device_gb = 45.0
band_chunk_size = 2
r_chunk_size = 8192
max_r_chunks = -1

# Disable QP WFN write — CrI3 sym WFN has nrk=48 (BGW unfold-extra) but U is
# computed on 36 unfolded k-pts → write_qp_wfn_h5 shape mismatch.  We only
# need sigma_freq_debug.dat for the sym-vs-nosym test.
write_wfn_h5 = false
sigma_freq_debug_output = true
sigma_freq_debug_file = sigma_freq_debug.dat
