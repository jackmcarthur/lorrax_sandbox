[cohsex]
wfn_file = WFN.h5
nval = 70
ncond = 10
nband = 80
sys_dim = 2
bispinor = true

# Smoke test: same centroid file for charge and transverse channels.
# Physically not correct (transverse channels want centroids sampled
# from current-density orbitals) but exercises the 4-channel ζ-fit +
# 7-tile V_q dispatch end-to-end.  A proper bispinor reference run
# regenerates current-channel centroids via
# centroid.kmeans_isdf with the current weighting mode.
centroids_file = centroids_frac_1504.txt
centroids_file_current = centroids_frac_1504.txt

memory_per_device_gb = 45.0
restart = false

x_only = true
do_screened = false
screening = cohsex
vhead = 0.0
whead_0freq = 0.0
