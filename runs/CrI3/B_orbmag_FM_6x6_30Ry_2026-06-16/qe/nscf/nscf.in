&control
   prefix = 'CrI3'
   pseudo_dir = './'
   calculation = 'nscf'
   verbosity = 'high'
   wf_collect = .true.
   disk_io = 'low'
/
&system
   ecutwfc = 30.0
   ibrav = 0
   nat = 8
   ntyp = 2
   noncolin = .true.
   lspinorb = .true.
   no_t_rev = .true.
   noinv = .true.
   nbnd = 180
   assume_isolated = '2D'
   nosym = .true.
   starting_magnetization(1) = 0.5
   starting_magnetization(2) = 0.0
   angle1(1) = 0.0
   angle1(2) = 0.0
   angle2(1) = 0.0
   angle2(2) = 0.0
/
! starting_magnetization is REQUIRED here: without it QE sets domag=.false.
! ("Non magnetic calculation with spin-orbit") and ignores the magnetization
! part of the SCF density -> non-magnetic (Kramers) bands.  nosym=.true.
! keeps all 36 explicit full-BZ k-points and avoids the irrek_nc crash that
! the magnetic-symmetry analysis hits on an explicit k-list.
&electrons
   electron_maxstep = 200
   conv_thr = 1e-9
   diagonalization = 'david'
   diago_david_ndim = 4
   diago_full_acc = .true.
/

ATOMIC_SPECIES
   Cr  51.996 'Cr.upf'
   I  126.904 'I.upf'

