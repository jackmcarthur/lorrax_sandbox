[cohsex]
wfn_file = WFN.h5

# FM (ferromagnetic) CrI3 monolayer, 6x6x1, nspinor=2 (bispinor), SOC.
# starting_magnetization(Cr)=0.5 ‖ +z; total mag 6.01 muB/cell; gapped
# (indirect gap 1.504 eV) so the delta-Vchi screened-W minimax is well-behaved.
# nelec=70 (occupied bispinor bands).  PRODUCTION Sigma window around the gap.
nval = 8
ncond = 8
nband = 180
sys_dim = 2

bispinor = false

centroids_file = centroids_frac_640.txt
centroids_file_current = centroids_frac_200_current.txt

memory_per_device_gb = 18.0

restart = false
max_r_chunks = -1

# Milestone-B: full delta-Vchi screened bispinor W on magnetic CrI3.
# do_screened=true fires the charge W^00 screening inversion + the bare
# Breit W^{ij} transverse channels through the IBZ->full-BZ unfold.
x_only = true
do_screened = false
screening = cohsex

# Head bypass: explicit overrides so the run does not require dipole.h5 /
# eps0mat.h5.  Heads = 0.
vhead = 0.0
whead_0freq = 0.0
write_wfn_h5 = false

cusolvermp_lu = off
