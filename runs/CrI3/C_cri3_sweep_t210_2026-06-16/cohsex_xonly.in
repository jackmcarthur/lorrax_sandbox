[cohsex]
wfn_file = WFN.h5

# CrI3 monolayer, 6x6x1, nspinor=2 (bispinor). nelec=70 (occupied).
# Small Sigma window for a FAST symmetry-correctness gate: the C3 R(x)R
# Lorentz IBZ->full-BZ unfold operates on V_q/W_q over the full centroid
# set, INDEPENDENT of nband; shrinking nval/ncond just makes the Sigma
# matrix-element sum cheap.  Both legs (IBZ + full-BZ) use IDENTICAL params.
nval = 6
ncond = 4
nband = 80
sys_dim = 2

bispinor = true

centroids_file = centroids_frac_300.txt
centroids_file_current = centroids_frac_212_current.txt

memory_per_device_gb = 36.0

restart = false
max_r_chunks = -1

# Screened-W bispinor COHSEX (Milestone A: charge W^00 screened, bare Breit
# W^{ij}).  This fires the CC + TT Lorentz channels through the IBZ->full-BZ
# unfold (unfold_bispinor_tiles), the C3 R(x)R rotation being the untested bit.
x_only = true
do_screened = false
screening = cohsex

# Head bypass: explicit overrides so do_screened does not require
# dipole.h5 / eps0mat.h5.  Both heads = 0 (cancels in the sym==nosym
# internal comparison; irrelevant to the unfold-machinery gate).
vhead = 0.0
whead_0freq = 0.0
write_wfn_h5 = false
